# Linux (aarch64) development image for slurm-monitor's agent side.
# nixos/nix ships a working Nix store; the flake's Slurm 25.11.6 closure is fetched at build time
# so `nix develop` against the mounted repo starts without downloading anything.
FROM nixos/nix:2.28.3

RUN echo 'experimental-features = nix-command flakes' >> /etc/nix/nix.conf \
    && echo 'accept-flake-config = true' >> /etc/nix/nix.conf

# dev.sh copies flake.nix and flake.lock next to this file before building.
COPY flake.nix flake.lock /opt/slurm-monitor-flake/

# Realise the devShell into a GC root so `nix-collect-garbage` cannot drop the Slurm closure.
RUN nix develop --profile /nix/var/nix/profiles/slurm-monitor-dev \
        path:/opt/slurm-monitor-flake -c true

# Keep the Linux venv apart from the macOS .venv that the bind mount brings along.
ENV UV_PROJECT_ENVIRONMENT=/work/.venv-linux \
    UV_PYTHON_DOWNLOADS=never

WORKDIR /work
