+def test_load_for_user(submit_job):
+    import os
+    import pwd
+
+    job_list = [submit_job(priority=0) for i in range(3)]
+    uid = os.getuid()
+
+    # Filtering by UID and by name must both return only our own Jobs.
+    for user in (uid, pwd.getpwuid(uid).pw_name):
+        jobs = Jobs.load(user=user)
+        assert all(job.user_id == uid for job in jobs.values())
+        for job in job_list:
+            assert job.id in jobs
+            assert isinstance(jobs[job.id], Job)
+
+    # A user without Jobs yields an empty collection, not an error.
+    assert len(Jobs.load(user="nobody")) == 0
+
+
 def test_load_steps(submit_job):
     submitted = submit_job()
